#!/bin/sh
# uri - Uri Reconstruction Instrument CLI
# General-purpose Git patch set management tool
# POSIX-compatible shell script

set -e

# Determine the script directory
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
LIB_DIR="${SCRIPT_DIR}/../lib"

# Load libraries
. "${LIB_DIR}/common.sh"
. "${LIB_DIR}/yaml.sh"
. "${LIB_DIR}/git.sh"
. "${LIB_DIR}/topsort.sh"
. "${LIB_DIR}/inherit.sh"
. "${LIB_DIR}/state.sh"

# Load commands
. "${LIB_DIR}/commands/init.sh"
. "${LIB_DIR}/commands/add.sh"
. "${LIB_DIR}/commands/remove.sh"
. "${LIB_DIR}/commands/exclude.sh"
. "${LIB_DIR}/commands/list.sh"
. "${LIB_DIR}/commands/expand.sh"
. "${LIB_DIR}/commands/collapse.sh"
. "${LIB_DIR}/commands/apply.sh"
. "${LIB_DIR}/commands/graph.sh"

# Version
VERSION="0.1.0"

# Print the main help text
usage() {
    cat <<EOF
uri - Uri Reconstruction Instrument v${VERSION}

A tool for managing versioned Git patch sets by feature.

Usage:
  uri <command> [options]

Commands:
  init       Initialize a patch set
  add        Add a patchset version or feature
  remove     Remove an upstream version, patchset version, or feature
  exclude    Exclude an inherited feature
  include    Include a feature excluded in the current version
  list       List versions, patches, or features
  expand     Apply a feature to the upstream source
  collapse   Extract a feature from the upstream source into a patch file
  apply      Apply all features in a patchset version
  graph      Print the feature dependency graph

Global options:
  -h, --help       Print this help text
  -v, --version    Print version information

Detailed help for each command:
  uri <command> --help

Examples:
  uri init --upstream https://example.com/project.git v1.2.3
  uri add v1.2.3 patch1.0                           # Add a patchset version
  uri add v1.2.3 patch1.0 feature-a                 # Add a feature
  uri list                                          # List upstream versions
  uri list v1.2.3                                   # List patchset versions
  uri expand v1.2.3 patch1.0 feature-a              # Apply to an automatic clone
  uri collapse v1.2.3 patch1.0 feature-a /path/to/project
  uri apply v1.2.3 patch1.0                         # Apply all features to an automatic clone
  uri graph v1.2.3 patch1.0                         # Print the dependency graph
EOF
}

# Print the version
version() {
    echo "uri version ${VERSION}"
}

# Check dependencies
check_dependencies() {
    require_cmd "git" "git is required. https://git-scm.com/"
    require_cmd "yq" "yq is required. https://github.com/mikefarah/yq"
}

# Main function
main() {
    # Check dependencies
    check_dependencies

    # Print help when no arguments are provided
    if [ $# -eq 0 ]; then
        usage
        exit 0
    fi

    # Process the first argument
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            version
            exit 0
            ;;
        init)
            shift
            cmd_init "$@"
            ;;
        add)
            shift
            cmd_add "$@"
            ;;
        remove)
            shift
            cmd_remove "$@"
            ;;
        exclude)
            shift
            cmd_exclude "$@"
            ;;
        include)
            shift
            cmd_include "$@"
            ;;
        list)
            shift
            cmd_list "$@"
            ;;
        expand)
            shift
            cmd_expand "$@"
            ;;
        collapse)
            shift
            cmd_collapse "$@"
            ;;
        apply)
            shift
            cmd_apply "$@"
            ;;
        graph)
            shift
            cmd_graph "$@"
            ;;
        *)
            die "Unknown command: $1. See 'uri --help'."
            ;;
    esac
}

# Run the main function
main "$@"
