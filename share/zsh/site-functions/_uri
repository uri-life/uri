#compdef uri
# uri - zsh completion

# Find URI_ROOT, the directory containing manifest.yaml
_uri_find_root() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/manifest.yaml" ]]; then
            echo "$dir"
            return 0
        fi
        dir=${dir:h}
    done
    return 1
}

# List upstream versions
_uri_upstream_versions() {
    local root
    root=$(_uri_find_root) || return
    local versions_dir="$root/versions"
    if [[ -d "$versions_dir" ]]; then
        local -a vers
        vers=("$versions_dir"/*(N/:t))
        compadd -a vers
    fi
}

# List patchset versions
_uri_patchset_versions() {
    local root upstream_version="$1"
    root=$(_uri_find_root) || return
    local patches_dir="$root/versions/$upstream_version/patches"
    if [[ -d "$patches_dir" ]]; then
        local -a vers
        vers=("$patches_dir"/*(N/:t))
        compadd -a vers
    fi
}

# List final active features
_uri_features() {
    local -a feats
    feats=(${(f)"$(command uri list "$1" "$2" 2>/dev/null | sed '/^info: No features\.$/d')"})
    compadd -a feats
}

# List features declared directly by the current manifest
_uri_local_feature_values() {
    local root upstream_version="$1" patchset_version="$2"
    root=$(_uri_find_root) || return
    (( $+commands[yq] )) || return
    local manifest="$root/versions/$upstream_version/patches/$patchset_version/manifest.yaml"
    [[ -f "$manifest" ]] || return
    yq eval '(.features // {}) | keys | .[]' "$manifest" 2>/dev/null
}

_uri_local_features() {
    local -a feats
    feats=(${(f)"$(_uri_local_feature_values "$1" "$2")"})
    compadd -a feats
}

_uri_excluded_features() {
    local root upstream_version="$1" patchset_version="$2"
    root=$(_uri_find_root) || return
    (( $+commands[yq] )) || return
    local -a feats
    feats=(${(f)"$(yq eval '(.excludes // []) | .[]' "$root/versions/$upstream_version/patches/$patchset_version/manifest.yaml" 2>/dev/null)"})
    compadd -a feats
}

_uri_inherited_features() {
    local upstream_version="$1" patchset_version="$2" feat
    local -a active local_feats inherited
    local -A local_set
    active=(${(f)"$(command uri list "$upstream_version" "$patchset_version" 2>/dev/null | sed '/^info: No features\.$/d')"})
    local_feats=(${(f)"$(_uri_local_feature_values "$upstream_version" "$patchset_version")"})
    for feat in "${local_feats[@]}"; do
        local_set[$feat]=1
    done
    for feat in "${active[@]}"; do
        if (( ! ${+local_set[$feat]} )); then
            inherited+=("$feat")
        fi
    done
    compadd -a inherited
}

# Extract a previous positional argument from the parsed arguments
_uri_get_prev_positional() {
    local target=$1
    shift
    local count=0 skip_next=false
    local value_opts=("$@")
    local i w
    for ((i = 2; i < CURRENT; i++)); do
        w="${words[i]}"
        if $skip_next; then
            skip_next=false
            continue
        fi
        case "$w" in
            -*)
                for vo in "${value_opts[@]}"; do
                    if [[ "$w" == "$vo" ]]; then
                        skip_next=true
                        break
                    fi
                done
                ;;
            *)
                count=$((count + 1))
                if [[ "$count" -eq "$target" ]]; then
                    echo "$w"
                    return
                fi
                ;;
        esac
    done
}

_uri_count_pos() {
    local count=0 skip_next=false
    local value_opts=("$@")
    local i w
    for ((i = 2; i < CURRENT; i++)); do
        w="${words[i]}"
        if $skip_next; then
            skip_next=false
            continue
        fi
        case "$w" in
            -*)
                for vo in "${value_opts[@]}"; do
                    if [[ "$w" == "$vo" ]]; then
                        skip_next=true
                        break
                    fi
                done
                ;;
            *)
                count=$((count + 1))
                ;;
        esac
    done
    echo "$count"
}

_uri_has_word() {
    local target="$1" i
    for ((i = 2; i < CURRENT; i++)); do
        [[ "${words[i]}" == "$target" ]] && return 0
    done
    return 1
}

# --- init ---
_uri_init() {
    local value_flags=(--upstream --branch-prefix --committer-name --committer-email)
    local npos=$(_uri_count_pos "${value_flags[@]}")
    case "$words[CURRENT-1]" in
        --upstream|--branch-prefix|--committer-name|--committer-email) return ;;
    esac
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(
            -h:Help
            --help:Help
            --upstream:upstream\ Git\ URL
            --branch-prefix:Branch\ prefix
            --committer-name:Committer\ name
            --committer-email:Committer\ email
        )'
        return
    fi
    if [[ "$npos" -eq 0 ]]; then
        _uri_upstream_versions
    fi
}

# --- add ---
_uri_add() {
    local npos value_flags=(--name --description --dependencies --dev-dependencies --inherits --inherits-upstream)
    npos=$(_uri_count_pos "${value_flags[@]}")

    case "$words[CURRENT-1]" in
        --name|--description|--dependencies|--dev-dependencies|--inherits|--inherits-upstream)
            return
            ;;
    esac
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(
            -h:Help
            --help:Help
            --name:Feature\ name
            --description:Feature\ description
            --dependencies:Required\ features
            --dev-dependencies:Development-only\ dependencies
            --inherits:Patchset\ version\ to\ inherit
            --inherits-upstream:Upstream\ version\ to\ inherit
        )'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1 "${value_flags[@]}")
            _uri_patchset_versions "$upstream_version"
            ;;
        2)
            local upstream_version=$(_uri_get_prev_positional 1 "${value_flags[@]}")
            local patchset_version=$(_uri_get_prev_positional 2 "${value_flags[@]}")
            _uri_features "$upstream_version" "$patchset_version"
            ;;
    esac
}

# --- exclude ---
_uri_exclude() {
    local npos=$(_uri_count_pos)
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(-h:Help --help:Help)'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1)
            _uri_patchset_versions "$upstream_version"
            ;;
        2)
            local upstream_version=$(_uri_get_prev_positional 1)
            local patchset_version=$(_uri_get_prev_positional 2)
            _uri_inherited_features "$upstream_version" "$patchset_version"
            ;;
    esac
}

# --- include ---
_uri_include() {
    local npos=$(_uri_count_pos)
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(-h:Help --help:Help)'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1)
            _uri_patchset_versions "$upstream_version"
            ;;
        2)
            local upstream_version=$(_uri_get_prev_positional 1)
            local patchset_version=$(_uri_get_prev_positional 2)
            _uri_excluded_features "$upstream_version" "$patchset_version"
            ;;
    esac
}

# --- remove ---
_uri_remove() {
    local npos=$(_uri_count_pos)
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(
            -h:Help
            --help:Help
            -f:Force\ deletion
            --force:Force\ deletion
        )'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1)
            _uri_patchset_versions "$upstream_version"
            ;;
        2)
            local upstream_version=$(_uri_get_prev_positional 1)
            local patchset_version=$(_uri_get_prev_positional 2)
            _uri_local_features "$upstream_version" "$patchset_version"
            ;;
    esac
}

# --- list ---
_uri_list() {
    local npos=$(_uri_count_pos)
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(-h:Help --help:Help)'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1)
            _uri_patchset_versions "$upstream_version"
            ;;
    esac
}

# --- expand ---
_uri_expand() {
    # After --continue/--abort, complete only destination directories
    if _uri_has_word "--continue" || _uri_has_word "--abort"; then
        if [[ "$PREFIX" == -* ]]; then
            _describe 'option' '(
                -h:Help
                --help:Help
                --continue:Continue\ after\ resolving\ conflicts
                --abort:Abort\ operation
            )'
        else
            _directories
        fi
        return
    fi

    local npos=$(_uri_count_pos)
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(
            -h:Help
            --help:Help
            --continue:Continue\ after\ resolving\ conflicts
            --abort:Abort\ operation
            --force:Delete\ existing\ branch
            --no-dev:Exclude\ development\ dependencies
        )'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1)
            _uri_patchset_versions "$upstream_version"
            ;;
        2)
            local upstream_version=$(_uri_get_prev_positional 1)
            local patchset_version=$(_uri_get_prev_positional 2)
            _uri_features "$upstream_version" "$patchset_version"
            ;;
        3) _directories ;;
    esac
}

# --- collapse ---
_uri_collapse() {
    local npos=$(_uri_count_pos)
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(-h:Help --help:Help --recursive:Recursively\ update\ dependent\ features)'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1)
            _uri_patchset_versions "$upstream_version"
            ;;
        2)
            local upstream_version=$(_uri_get_prev_positional 1)
            local patchset_version=$(_uri_get_prev_positional 2)
            _uri_features "$upstream_version" "$patchset_version"
            ;;
        3) _directories ;;
    esac
}

# --- apply ---
_uri_apply() {
    # After --continue/--abort, complete only destination directories
    if _uri_has_word "--continue" || _uri_has_word "--abort"; then
        if [[ "$PREFIX" == -* ]]; then
            _describe 'option' '(
                -h:Help
                --help:Help
                --continue:Continue\ after\ resolving\ conflicts
                --abort:Abort\ operation
            )'
        else
            _directories
        fi
        return
    fi

    local npos=$(_uri_count_pos)
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(
            -h:Help
            --help:Help
            --continue:Continue\ after\ resolving\ conflicts
            --abort:Abort\ operation
        )'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1)
            _uri_patchset_versions "$upstream_version"
            ;;
        2) _directories ;;
    esac
}

# --- graph ---
_uri_graph() {
    local npos=$(_uri_count_pos --format)

    if [[ "$words[CURRENT-1]" == "--format" ]]; then
        _describe 'format' '(tree:Tree\ format dot:Graphviz\ DOT\ format)'
        return
    fi
    if [[ "$PREFIX" == --format=* ]]; then
        compadd -P '--format=' tree dot
        return
    fi
    if [[ "$PREFIX" == -* ]]; then
        _describe 'option' '(
            -h:Help
            --help:Help
            --include-dev:Include\ development\ dependencies
            --format:Output\ format
        )'
        return
    fi
    case "$npos" in
        0) _uri_upstream_versions ;;
        1)
            local upstream_version=$(_uri_get_prev_positional 1 --format)
            _uri_patchset_versions "$upstream_version"
            ;;
    esac
}

# --- Main dispatcher ---
_uri() {
    local curcontext="$curcontext" state line
    local -A opt_args

    _arguments -C \
        '-h[Help]' \
        '--help[Help]' \
        '-v[Print version]' \
        '--version[Print version]' \
        '1:command:->subcmd' \
        '*::arg:->args' && return

    case "$state" in
        subcmd)
            _describe 'command' '(
                init:Initialize\ a\ patch\ set
                add:Add\ a\ patchset\ version\ or\ feature
                remove:Remove\ a\ version\ or\ feature
                exclude:Exclude\ an\ inherited\ feature
                include:Include\ a\ feature\ excluded\ in\ the\ current\ version
                list:List\ versions\ or\ features
                expand:Apply\ a\ feature\ to\ the\ upstream\ source
                collapse:Extract\ a\ patch\ file
                apply:Apply\ all\ features
                graph:Print\ the\ feature\ dependency\ graph
            )'
            ;;
        args)
            case "${line[1]}" in
                init)     _uri_init ;;
                add)      _uri_add ;;
                remove)   _uri_remove ;;
                exclude)  _uri_exclude ;;
                include)  _uri_include ;;
                list)     _uri_list ;;
                expand)   _uri_expand ;;
                collapse) _uri_collapse ;;
                apply)    _uri_apply ;;
                graph)    _uri_graph ;;
            esac
            ;;
    esac
}

_uri "$@"
