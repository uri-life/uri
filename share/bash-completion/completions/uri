# uri - bash completion
# shellcheck shell=bash
# Intentionally split compgen output into arrays for Bash 3.2 compatibility.
# shellcheck disable=SC2207

# Find URI_ROOT, the directory containing manifest.yaml
_uri_find_root() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/manifest.yaml" ]]; then
            echo "$dir"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

# List upstream versions under versions/
_uri_upstream_versions() {
    local root
    root=$(_uri_find_root) || return
    local versions_dir="$root/versions"
    if [[ -d "$versions_dir" ]]; then
        local d
        for d in "$versions_dir"/*/; do
            [[ -d "$d" ]] && basename "$d"
        done
    fi
}

# List patchset versions under versions/<upstream_version>/patches/
_uri_patchset_versions() {
    local root upstream_version="$1"
    root=$(_uri_find_root) || return
    local patches_dir="$root/versions/$upstream_version/patches"
    if [[ -d "$patches_dir" ]]; then
        local d
        for d in "$patches_dir"/*/; do
            [[ -d "$d" ]] && basename "$d"
        done
    fi
}

# List final active features
_uri_features() {
    command uri list "$1" "$2" 2>/dev/null | sed '/^info: No features\.$/d'
}

# List features declared directly by the current manifest
_uri_local_features() {
    local root upstream_version="$1" patchset_version="$2"
    root=$(_uri_find_root) || return
    local manifest="$root/versions/$upstream_version/patches/$patchset_version/manifest.yaml"
    [[ -f "$manifest" ]] || return
    command -v yq &>/dev/null || return
    yq eval '(.features // {}) | keys | .[]' "$manifest" 2>/dev/null
}

# List features excluded directly by the current manifest
_uri_excluded_features() {
    local root upstream_version="$1" patchset_version="$2"
    root=$(_uri_find_root) || return
    command -v yq &>/dev/null || return
    yq eval '(.excludes // []) | .[]' "$root/versions/$upstream_version/patches/$patchset_version/manifest.yaml" 2>/dev/null
}

# List active features not declared directly by the current manifest
_uri_inherited_features() {
    local upstream_version="$1" patchset_version="$2" feature local_features
    local_features=$(_uri_local_features "$upstream_version" "$patchset_version")
    for feature in $(_uri_features "$upstream_version" "$patchset_version"); do
        if ! printf '%s\n' "$local_features" | grep -Fqx -- "$feature"; then
            echo "$feature"
        fi
    done
}

# Count only positional arguments, excluding flags and flag values
_uri_count_positional() {
    local count=0 i skip_next=false
    # $1 = pattern for options that consume a value, for example "--upstream|--name|..."
    local value_flags="$1"
    shift
    for i in "$@"; do
        if $skip_next; then
            skip_next=false
            continue
        fi
        case "$i" in
            -*)
                # Skip the next argument when the flag consumes a value
                if [[ -n "$value_flags" ]] && echo "$i" | grep -qE "^($value_flags)$"; then
                    skip_next=true
                fi
                ;;
            *)
                count=$((count + 1))
                ;;
        esac
    done
    echo "$count"
}

# Return the nth positional argument
_uri_get_positional() {
    local target="$1" value_flags="$2"
    shift 2
    local count=0 skip_next=false i
    for i in "$@"; do
        if $skip_next; then
            skip_next=false
            continue
        fi
        case "$i" in
            -*)
                if [[ -n "$value_flags" ]] && echo "$i" | grep -qE "^($value_flags)$"; then
                    skip_next=true
                fi
                ;;
            *)
                count=$((count + 1))
                if [[ "$count" -eq "$target" ]]; then
                    echo "$i"
                    return
                fi
                ;;
        esac
    done
}

# Check whether a specific flag is already present
_uri_has_flag() {
    local flag="$1"
    shift
    local w
    for w in "$@"; do
        [[ "$w" == "$flag" ]] && return 0
    done
    return 1
}

_uri() {
    local cur prev words cword
    if type _init_completion &>/dev/null; then
        _init_completion || return
    else
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        words=("${COMP_WORDS[@]}")
        cword=$COMP_CWORD
    fi

    # Determine the subcommand from the first positional argument
    local subcmd="" i
    for ((i = 1; i < cword; i++)); do
        case "${words[i]}" in
            -*) ;;
            *)
                subcmd="${words[i]}"
                break
                ;;
        esac
    done

    # No subcommand determined yet
    if [[ -z "$subcmd" ]]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "-h --help -v --version" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "init add remove exclude include list expand collapse apply graph" -- "$cur"))
        fi
        return
    fi

    # Arguments after the subcommand and before cur
    local sub_args=()
    local found=false
    for ((i = 1; i < cword; i++)); do
        if $found; then
            sub_args+=("${words[i]}")
        elif [[ "${words[i]}" == "$subcmd" ]]; then
            found=true
        fi
    done

    case "$subcmd" in
        init)
            _uri_complete_init "${sub_args[@]}"
            ;;
        add)
            _uri_complete_add "${sub_args[@]}"
            ;;
        remove)
            _uri_complete_remove "${sub_args[@]}"
            ;;
        exclude)
            _uri_complete_exclude "${sub_args[@]}"
            ;;
        include)
            _uri_complete_include "${sub_args[@]}"
            ;;
        list)
            _uri_complete_list "${sub_args[@]}"
            ;;
        expand)
            _uri_complete_expand "${sub_args[@]}"
            ;;
        collapse)
            _uri_complete_collapse "${sub_args[@]}"
            ;;
        apply)
            _uri_complete_apply "${sub_args[@]}"
            ;;
        graph)
            _uri_complete_graph "${sub_args[@]}"
            ;;
    esac
}

# --- Command-specific completion functions ---

_uri_complete_init() {
    local npos
    local vflags="--upstream|--branch-prefix|--committer-name|--committer-email"
    npos=$(_uri_count_positional "$vflags" "$@")

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help --upstream --branch-prefix --committer-name --committer-email" -- "$cur"))
        return
    fi

    case "$prev" in
        --upstream|--branch-prefix|--committer-name|--committer-email)
            return
            ;;
    esac

    # Positional argument 1: upstream_version
    if [[ "$npos" -eq 0 ]]; then
        COMPREPLY=($(compgen -W "$(_uri_upstream_versions)" -- "$cur"))
    fi
}

_uri_complete_add() {
    local npos
    npos=$(_uri_count_positional "--name|--description|--dependencies|--dev-dependencies|--inherits|--inherits-upstream" "$@")

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help --name --description --dependencies --dev-dependencies --inherits --inherits-upstream" -- "$cur"))
        return
    fi

    case "$prev" in
        --name|--description|--dependencies|--dev-dependencies|--inherits|--inherits-upstream)
            return  # Free-form input
            ;;
    esac

    local vflags="--name|--description|--dependencies|--dev-dependencies|--inherits|--inherits-upstream"
    case "$npos" in
        0) COMPREPLY=($(compgen -W "$(_uri_upstream_versions)" -- "$cur")) ;;
        1)
            local upstream_version
            upstream_version=$(_uri_get_positional 1 "$vflags" "$@")
            COMPREPLY=($(compgen -W "$(_uri_patchset_versions "$upstream_version")" -- "$cur"))
            ;;
        2)
            local upstream_version patchset_version
            upstream_version=$(_uri_get_positional 1 "$vflags" "$@")
            patchset_version=$(_uri_get_positional 2 "$vflags" "$@")
            COMPREPLY=($(compgen -W "$(_uri_features "$upstream_version" "$patchset_version")" -- "$cur"))
            ;;
    esac
}

_uri_complete_exclude() {
    local npos
    npos=$(_uri_count_positional "" "$@")

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
        return
    fi

    case "$npos" in
        0) COMPREPLY=($(compgen -W "$(_uri_upstream_versions)" -- "$cur")) ;;
        1)
            local upstream_version
            upstream_version=$(_uri_get_positional 1 "" "$@")
            COMPREPLY=($(compgen -W "$(_uri_patchset_versions "$upstream_version")" -- "$cur"))
            ;;
        2)
            local upstream_version patchset_version
            upstream_version=$(_uri_get_positional 1 "" "$@")
            patchset_version=$(_uri_get_positional 2 "" "$@")
            COMPREPLY=($(compgen -W "$(_uri_inherited_features "$upstream_version" "$patchset_version")" -- "$cur"))
            ;;
    esac
}

