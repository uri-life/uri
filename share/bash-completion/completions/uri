            COMPREPLY=($(compgen -W "$(_uri_patchset_versions "$upstream_version")" -- "$cur"))
            ;;
    esac
}

_uri_complete_expand() {
    # With --continue/--abort, complete only destination directories
    if _uri_has_flag "--continue" "$@" || _uri_has_flag "--abort" "$@"; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "-h --help --continue --abort" -- "$cur"))
        else
            _filedir -d
        fi
        return
    fi

    local npos
    npos=$(_uri_count_positional "" "$@")

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help --continue --abort --force --no-dev" -- "$cur"))
        return
    fi

    case "$npos" in
        0) COMPREPLY=($(compgen -W "$(_uri_upstream_versions)" -- "$cur")) ;;
        1)
            local upstream_version
            upstream_version=$(_uri_get_positional 1 "" "$@")
            COMPREPLY=($(compgen -W "$(_uri_patchset_versions "$upstream_version")" -- "$cur"))
            ;;
        2)
            local upstream_version patchset_version
            upstream_version=$(_uri_get_positional 1 "" "$@")
            patchset_version=$(_uri_get_positional 2 "" "$@")
            COMPREPLY=($(compgen -W "$(_uri_features "$upstream_version" "$patchset_version")" -- "$cur"))
            ;;
        3) _filedir -d ;;
    esac
}

