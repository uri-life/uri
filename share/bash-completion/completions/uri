            ;;
        3) _filedir -d ;;
    esac
}

_uri_complete_apply() {
    # With --continue/--abort, complete only destination directories
    if _uri_has_flag "--continue" "$@" || _uri_has_flag "--abort" "$@"; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "-h --help --continue --abort" -- "$cur"))
        else
            _filedir -d
        fi
        return
    fi

    local npos
    npos=$(_uri_count_positional "" "$@")

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help --continue --abort" -- "$cur"))
        return
    fi

    case "$npos" in
        0) COMPREPLY=($(compgen -W "$(_uri_upstream_versions)" -- "$cur")) ;;
        1)
            local upstream_version
            upstream_version=$(_uri_get_positional 1 "" "$@")
            COMPREPLY=($(compgen -W "$(_uri_patchset_versions "$upstream_version")" -- "$cur"))
            ;;
        2) _filedir -d ;;
    esac
}

_uri_complete_graph() {
    local npos
    npos=$(_uri_count_positional "--format" "$@")

    if [[ "$prev" == "--format" ]]; then
        COMPREPLY=($(compgen -W "tree dot" -- "$cur"))
        return
    fi

    if [[ "$cur" == --format=* ]]; then
        COMPREPLY=($(compgen -W "tree dot" -- "${cur#--format=}"))
        COMPREPLY=("${COMPREPLY[@]/#/--format=}")
        return
    fi

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help --include-dev --format" -- "$cur"))
        return
    fi

    case "$npos" in
        0) COMPREPLY=($(compgen -W "$(_uri_upstream_versions)" -- "$cur")) ;;
        1)
            local upstream_version
            upstream_version=$(_uri_get_positional 1 "--format" "$@")
            COMPREPLY=($(compgen -W "$(_uri_patchset_versions "$upstream_version")" -- "$cur"))
            ;;
    esac
}

complete -F _uri uri
